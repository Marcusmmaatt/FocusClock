<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标前景层：白色时钟表盘 + 时针/分针（品牌靛蓝）。
  安全区为中心 72dp 直径，所有图形均落在安全区内，避免被圆形/圆角遮罩裁切。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 白色表盘（圆心 54,54，半径 28） -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,26a28,28 0 1,0 0.01,0z" />

    <!-- 分针（竖直向上）与时针（指向 9 点偏下），圆角线帽 -->
    <path
        android:strokeColor="#3B5BDB"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M54,54 L54,40" />
    <path
        android:strokeColor="#3B5BDB"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M54,54 L44,59" />

    <!-- 中心轴点 -->
    <path
        android:fillColor="#3B5BDB"
        android:pathData="M54,51.5a2.5,2.5 0 1,0 0.01,0z" />
</vector>
